    "vault:local": "NODE_ENV=development netlify-plugin-vault-variables"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "weblogin-auth-sdk": "^3.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "netlify-plugin-vault-variables": "^3.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xml-crypto": "^6.4.0"
  }
